}
% In-set Mathfrak Commands
\foreach \x in {A,...,Z}{%
    \expandafter\xdef\csname inf\x\endcsname{%
    \noexpand\ensuremath{\noexpand\in\noexpand\csname f\x\endcsname}}%
}

% Format commands
\newcommand*{\newfaktor}[2]{% \newfaktor{#1}{#2} -> #1\#2
  \raisebox{-0.5\height}{#1}% Numerator
  \diagdown\mkern-5mu% Slash /
  \raisebox{0.5\height}{#2}% Denominator
}

